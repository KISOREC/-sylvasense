# API
APP_ENV=development
APP_NAME=SYLVASENSE API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL/PostGIS
POSTGRES_DB=sylvasense
POSTGRES_USER=sylvasense
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sylvasense:change-me-locally@localhost:5432/sylvasense

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend (Vite exposes VITE_* values to the browser; never put secrets here)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_MAPS_API_KEY=

# Google Earth Engine (optional; keep credential files outside this repository)
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_CREDENTIALS_PATH=
